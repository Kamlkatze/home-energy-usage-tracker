# Database Credentials (shared between dev/prod)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=energy_tracker
POSTGRES_DB_TEST=energy_tracker_test

# Network Configuration
DATABASE_HOST=localhost  # for native development
DATABASE_PORT=5432

# Backend Configuration
API_V1_PREFIX=/api
PROJECT_NAME=Home Energy Usage Tracker
CORS_ORIGINS=["http://localhost:3500", "http://localhost:5173"]
# APP_VERSION comes from the [project] version in backend/pyproject.toml
# (importlib.metadata) - leave this unset; bump pyproject.toml to change it.

# Frontend Configuration (for native development only)
VITE_API_URL=http://localhost:8000